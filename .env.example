/**
 * @file .env.example
 * Environment variable template for WebHawk local development.
 * Copy to .env and fill in your actual secrets.
 * NEVER commit .env to version control.
 */

# ── Provider Secrets ──────────────────────────────────────────────────────────
WOMPI_SECRET=your_wompi_integration_secret_here
WOMPI_SECRET_PREV=

STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here
STRIPE_WEBHOOK_SECRET_PREV=

GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_WEBHOOK_SECRET_PREV=

# ── Config ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
